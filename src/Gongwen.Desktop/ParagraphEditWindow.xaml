<Window x:Class="Gongwen.Desktop.ParagraphEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑段落文字" Width="720" Height="430" MinWidth="570" MinHeight="340" WindowStartupLocation="CenterOwner" Background="#F3F6FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="修改当前一段的文字，继续使用当前段落角色。完整文档调整可在 WPS 中保存后重新拖入。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,7,0,0"/></StackPanel>
  <TextBox x:Name="EditorText" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" FontSize="16" Margin="0"/>
  <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,10" Text="支持纯文字；不能加入换行、制表符或新增段落。"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button Content="保存本段修改" Click="Save_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Margin="0"/></StackPanel>
 </Grid>
</Window>
